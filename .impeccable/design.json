  "narrative": {
    "northStar": "The Local Service Editorial",
    "overview": "The current homepage pairs clear, service-led information with commercial photographs of Glamorgan's technicians. The official sailboat logo sits on an intentional black field. White and ivory space, fine rules, and legible type give the page a calm, capable character.\n\nThis is the homepage's implemented design system. The other eleven static pages have not been rebuilt into it; future WordPress work should use this as the visual reference only after the homepage direction is approved.",
    "keyCharacteristics": [
      "A four-person team image leads; supporting photographs show real home-service work.",
      "Editorial serif headings and direct sans-serif service copy establish hierarchy.",
      "Broad sections and thin dividers organize information without repetitive card tiles.",
      "The request action is gold; urgent mobile service access uses red."
    ],
    "rules": [
      {
        "name": "The Reserved Accent Rule",
        "body": "Keep gold concentrated on the primary action and small points of emphasis; reserve red for urgent service access.",
        "section": "colors"
      },
      {
        "name": "The Plain Service Rule",
        "body": "State the service first, then explain it in short, ordinary language.",
        "section": "typography"
      },
      {
        "name": "The People First Rule",
        "body": "Show the entire group portrait without cropping at the supported desktop, tablet, and mobile widths.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do use the official logo against a black header or footer field.",
      "Do show permanent technician, equipment, and local-home imagery.",
      "Do keep service and contact actions clear at every supported width."
    ],
    "donts": [
      "Don't introduce seasonal or temporary campaign artwork or copy.",
      "Don't turn service links into a grid of raised, repetitive cards.",
      "Don't use Signal Red as a general decorative accent."
    ]
  }
